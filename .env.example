# ===================================================
# BookMyGlow Backend Environment Configuration Template
# Copy this file to .env and fill in the values
# ===================================================

PORT=5001
NODE_ENV=development

# Remote MongoDB Atlas URI (leave empty for instant local embedded DB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bookmyglow?retryWrites=true&w=majority

# JWT Token Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Comma-separated allowed frontend URLs
FRONTEND_URL=http://localhost:5173,http://localhost:3000,https://your-production-salon-app.vercel.app

# Salon Profile
SALON_NAME="Bunty's Luxury Unisex Salon & Spa"
SALON_PHONE="+919904334450"
SALON_ADDRESS="Above Deep Chinese, Near HDFC Bank, Baroi Rd, Mundra"
